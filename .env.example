# Placeholders only. Never commit real values.
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/action_inbox

# Session signing secret (openssl rand -base64 48). Minimum 32 characters.
BETTER_AUTH_SECRET=

# Sign-in providers. Leave blank to hide the method. These are SEPARATE OAuth apps
# from the GitHub/Slack/Google connector apps configured later.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email (magic links, notifications). Leave blank to hide email sign-in.
SMTP_URL=
SMTP_FROM=

# Credential vault keys: 32 random bytes, base64 (openssl rand -base64 32). Keep these outside the
# database and back them up separately. Add a new _V<n> and set ACTIVE_VERSION to rotate.
CREDENTIAL_ENCRYPTION_KEY_V1=
CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=1

# Connector OAuth apps (GitHub / Slack / Google). Separate from the sign-in apps above.
# Callback URLs: ${APP_URL}/api/connectors/{github|slack|gmail}/callback
CONNECTOR_GITHUB_CLIENT_ID=
CONNECTOR_GITHUB_CLIENT_SECRET=
CONNECTOR_SLACK_CLIENT_ID=
CONNECTOR_SLACK_CLIENT_SECRET=
CONNECTOR_GOOGLE_CLIENT_ID=
CONNECTOR_GOOGLE_CLIENT_SECRET=

# Secret for POST /api/internal/sweep (called by a scheduler). Minimum 32 characters. Blank disables it.
CRON_SECRET=
